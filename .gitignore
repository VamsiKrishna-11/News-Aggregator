# ==============================================================================
# PulseNews Root .gitignore
# Prevents node_modules, secrets, build artifacts, and system files from being tracked
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and Secrets
.env
.env.*
*.env
*.env.*
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Strictly preserve .env.example files across repository
!.env.example
!.env.*.example
!*.env.example
!*.env.*.example

# Production Build Outputs
dist/
dist-ssr/
build/
out/
.next/

# Logs & Runtime Cache
logs/
*.log
.eslintcache
.stylelintcache

# Playwright & Testing Artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/
.nyc_output/
coverage/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
