# ==============================================================================
# Backend Server .gitignore
# ==============================================================================

# Dependencies
node_modules/

# Environment Variables & Secrets (Keep .env.example)
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
coverage/
.nyc_output/

# Operating System Files
.DS_Store
Thumbs.db
