# ==============================================================================
# Frontend Client .gitignore
# ==============================================================================

# Dependencies
node_modules/

# Production Build Outputs
dist/
dist-ssr/
build/

# Environment Variables & Secrets (Keep .env.example)
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Playwright & Testing Artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/

# Operating System Files
.DS_Store
Thumbs.db

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
